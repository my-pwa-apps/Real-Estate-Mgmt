{
	"rules": {
		".read": false,
		".write": false,

		"panden": {
			".indexOn": ["adres", "type", "status"],
			".read": "auth != null",
			".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			"$pandId": {
				".validate": "newData.hasChildren(['adres', 'postcode', 'plaats', 'type', 'status']) && newData.child('adres').isString() && newData.child('postcode').isString() && newData.child('plaats').isString() && newData.child('type').isString() && newData.child('status').isString()"
			}
		},

		"huurders": {
			".indexOn": ["achternaam", "email", "relatieType"],
			".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			"$huurderId": {
				".validate": "newData.hasChildren(['voornaam', 'achternaam', 'email']) && newData.child('voornaam').isString() && newData.child('achternaam').isString() && newData.child('email').isString()"
			}
		},

		"contracten": {
			".indexOn": ["startdatum", "einddatum", "huurderId", "pandId"],
			".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			"$contractId": {
				".validate": "newData.hasChildren(['huurderId', 'pandId', 'startdatum', 'huurprijs']) && newData.child('huurderId').isString() && newData.child('pandId').isString() && newData.child('startdatum').isString() && newData.child('huurprijs').isNumber() && (!data.exists() || data.child('contractFase').val() === 'concept' || (newData.child('huurderId').val() === data.child('huurderId').val() && newData.child('pandId').val() === data.child('pandId').val() && newData.child('startdatum').val() === data.child('startdatum').val() && newData.child('huurprijs').val() === data.child('huurprijs').val() && newData.child('borg').val() === data.child('borg').val() && newData.child('contractType').val() === data.child('contractType').val()))"
			}
		},

		"onderhoud": {
			".indexOn": ["status", "prioriteit", "pandId", "createdAt"],
			".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			"$meldingId": {
				".validate": "newData.hasChildren(['pandId', 'titel', 'status', 'prioriteit']) && newData.child('pandId').isString() && newData.child('titel').isString() && newData.child('status').isString() && newData.child('prioriteit').isString()"
			}
		},

		"transacties": {
			".indexOn": ["datum", "type", "categorie"],
			".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			"$transactieId": {
				".validate": "newData.hasChildren(['beschrijving', 'bedrag', 'datum', 'type']) && newData.child('beschrijving').isString() && newData.child('bedrag').isNumber() && newData.child('datum').isString() && newData.child('type').isString()"
			}
		},

		"werkbonnen": {
			".indexOn": [
				"werkbonNummer",
				"meldingId",
				"pandId",
				"status",
				"aanmaakDatum"
			],
			".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			"$werkbonId": {
				".validate": "newData.hasChildren(['werkbonNummer', 'meldingId', 'pandId', 'status']) && newData.child('werkbonNummer').isString() && newData.child('meldingId').isString() && newData.child('pandId').isString() && newData.child('status').isString()"
			}
		},

		"invoices": {
			".indexOn": ["invoiceNumber", "invoiceDate", "dueDate", "status"],
			".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			"$invoiceId": {
				".validate": "newData.hasChildren(['invoiceNumber', 'invoiceDate', 'amount', 'status']) && newData.child('invoiceNumber').isString() && newData.child('invoiceDate').isString() && newData.child('amount').isNumber() && newData.child('status').isString()"
			}
		},

		"auditLog": {
			".indexOn": ["timestamp", "entityType", "action", "userId"],
			".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN')",
			".write": "auth != null",
			"$logId": {
				".validate": "newData.hasChildren(['timestamp', 'action', 'entityType']) && newData.child('timestamp').isString() && newData.child('action').isString() && newData.child('entityType').isString()"
			}
		},

		"betalingen": {
			".indexOn": ["contractId", "datum", "status"],
			".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			"$betalingId": {
				".validate": "newData.hasChildren(['contractId', 'datum', 'status']) && newData.child('contractId').isString() && newData.child('datum').isString() && newData.child('status').isString()"
			}
		},

		"settings": {
			".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')",
			".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN')"
		},

		"admins": {
			".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN')",
			".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN')"
		}
	}
}
