{
  "rules": {
    ".read": "auth != null",
    ".write": false,
    
    "panden": {
      ".indexOn": ["adres", "type", "status"],
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')"
    },
    
    "huurders": {
      ".indexOn": ["achternaam", "email"],
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')"
    },
    
    "contracten": {
      ".indexOn": ["startdatum", "einddatum", "huurderId", "pandId"],
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')"
    },
    
    "onderhoud": {
      ".indexOn": ["status", "prioriteit", "pandId", "createdAt"],
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')"
    },
    
    "transacties": {
      ".indexOn": ["datum", "type", "categorie"],
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')"
    },
    
    "werkbonnen": {
      ".indexOn": ["werkbonNummer", "meldingId", "pandId", "status", "aanmaakDatum"],
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')"
    },
    
    "invoices": {
      ".indexOn": ["invoiceNumber", "invoiceDate", "dueDate"],
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')"
    },
    
    "auditLog": {
      ".indexOn": ["timestamp", "entityType", "action", "userId"],
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN')",
      ".write": "auth != null"
    },
    
    "betalingen": {
      ".indexOn": ["contractId", "datum", "status"],
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN' || auth.token.role === 'MANAGER')"
    },
    
    "settings": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN'"
    },
    
    "admins": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN'"
    },
    
    "adminEmails": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).exists() || auth.token.role === 'ADMIN'"
    }
  }
}
}
